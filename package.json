{
  "name": "cinedb",
  "private": true,
  "description": "Fast personal browser for IMDb's most popular titles: search, filters, watchlist. Preact + TypeScript PWA.",
  "keywords": [
    "imdb",
    "movies",
    "preact",
    "pwa",
    "tv-series",
    "typescript",
    "watchlist"
  ],
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "check": "vp check",
    "test": "vp test",
    "fetch": "bun scripts/fetch.ts",
    "size": "bun run build && size-limit",
    "e2e": "playwright test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "preact": "^11.2.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@size-limit/file": "^14.3.0",
    "@types/bun": "^1.4.4",
    "fast-check": "^4.10.2",
    "lefthook": "^2.2.2",
    "size-limit": "^14.3.0",
    "vite-plus": "^1.6.0"
  },
  "packageManager": "bun@1.4.4"
}
